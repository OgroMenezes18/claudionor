{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": false,

    "network": {
      "strictAllowlist": true,
      "allowedDomains": @@DOMINIOS@@
    },

    "filesystem": {
      "denyWrite": [
        "@@RAIZ@@/.claude",
        "@@RAIZ@@/CLAUDE.md"
      ]
    },

    "credentials": {
      "files": [
        { "path": "~/.config/claude", "mode": "deny" },
        { "path": "~/.config/gh", "mode": "deny" },
        { "path": "~/.ssh", "mode": "deny" },
        { "path": "~/.aws", "mode": "deny" }
      ]
    }
  },

  "permissions": {
    "deny": [
      "Read(/@@HOME@@/.config/claude/**)",
      "Read(/@@HOME@@/.config/gh/**)",
      "Read(/@@HOME@@/.ssh/**)",
      "Read(/@@HOME@@/.aws/**)",
      "Edit(/@@RAIZ@@/.claude/**)",
      "Edit(/@@RAIZ@@/CLAUDE.md)"
    ]
  }
}
